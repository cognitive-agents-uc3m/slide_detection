# Copia este fichero a ".env" y rellena tu proyecto de Google Cloud.
# serve_visual_test.py y batch_analyze.py lo cargan automáticamente
# (python-dotenv) si existe.
#
# Requiere: un proyecto de Google Cloud con la API de Vertex AI habilitada,
# y haber ejecutado `gcloud auth application-default login`.

GEMINI_PROJECT_ID=tu-proyecto-gcp
GEMINI_LOCATION=global

# Opcional — modelo de Gemini a usar (por defecto: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
